# Azure AD credentials
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint file URL
SHAREPOINT_PATH=
SHAREPOINT_SHEET=Sheet1

# Local file path
LOCAL_FILE_PATH=/path/to/local/file.xlsx

# Browser execution
HEADLESS_BROWSER=false

# UCS credentials
UCS_USER=
UCS_PASSWORD=
STD_PASS=

# Outlook sender for user-facing informative emails
OUTLOOK_FROM=
INFORMATIVE_EMAIL_BCC=
SEND_EXISTING_USER_EMAIL=true

# Execution alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_ON_SUCCESS=true
ALERT_ON_ERROR=true
